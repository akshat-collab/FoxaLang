fn main() {
    let p = Point { x: 1, y: 2 };
    print(p.x);

    let mut i = 0;
    while i < 3 {
        print(i);
        i = i + 1;
    }

    for n in [10, 20] {
        print(n);
    }

    match Some(42) {
        Some(x) => print(x),
        None => print(0),
    }
}

struct Point {
    x: Int,
    y: Int,
}
